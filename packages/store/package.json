{
  "name": "@mfa/store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@mfa/contracts": "workspace:*",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@mfa/eslint-config": "workspace:*",
    "@mfa/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "eslint": "^10.8.1",
    "react": "^19.2.8",
    "typescript": "6.0.3"
  }
}
