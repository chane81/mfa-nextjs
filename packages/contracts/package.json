{
  "name": "@mfa/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./remote": {
      "types": "./dist/remote-contract.d.ts",
      "default": "./dist/remote-contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "mf:types": "mf dts --fetch true --generate false && node ../../scripts/gen-module-ids.ts"
  },
  "dependencies": {
    "@mfa/remote-config": "workspace:*"
  },
  "devDependencies": {
    "@mfa/eslint-config": "workspace:*",
    "@mfa/typescript-config": "workspace:*",
    "@module-federation/cli": "^2.8.2",
    "@module-federation/runtime": "^2.8.2",
    "@types/react": "^19.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.1",
    "typescript": "6.0.3"
  }
}
