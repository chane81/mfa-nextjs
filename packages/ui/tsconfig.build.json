{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /**
     * **emit 전용 설정.** `build` · `dev` 스크립트만 이 파일을 가리킨다.
     *
     * 옆의 `tsconfig.json` 은 테스트를 포함하는데, 이 패키지는 `dist` 로 emit 하므로
     * 그대로 빌드하면 테스트가 배포 산출물에 들어간다. 그래서 여기서만 뺀다.
     */
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
