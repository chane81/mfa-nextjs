{
  "name": "@mfa/remote-cart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,ssr -c green,gray \"rsbuild dev\" \"rsbuild build --config rsbuild.server.config.ts --watch\"",
    "build": "rsbuild build && pnpm build:ssr",
    "build:ssr": "rsbuild build --config rsbuild.server.config.ts",
    "start": "rsbuild preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@mfa/contracts": "workspace:*",
    "@mfa/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@mfa/eslint-config": "workspace:*",
    "@mfa/typescript-config": "workspace:*",
    "@module-federation/rsbuild-plugin": "^2.8.2",
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-react": "^2.1.0",
    "@types/react": "^19.2.2",
    "@types/node": "^24.10.1",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.1",
    "typescript": "6.0.3"
  }
}
