{
  "name": "@mfa/remote-cart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,ssr -c green,gray --kill-others-on-fail \"rsbuild dev\" \"rsbuild build --config rsbuild.server.config.ts --watch\"",
    "build": "node ../../scripts/mf-build-version.ts && rsbuild build && pnpm build:ssr && pnpm stamp",
    "build:ssr": "rsbuild build --config rsbuild.server.config.ts",
    "stamp": "node ../../scripts/stamp-remote-version.ts cart",
    "start": "node ../../scripts/serve-remote-dist.ts cart",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .mf-version .turbo"
  },
  "dependencies": {
    "@mfa/contracts": "workspace:*",
    "@mfa/store": "workspace:*",
    "@mfa/tailwind-config": "workspace:*",
    "@mfa/ui": "workspace:*",
    "@mfa/utils": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@mfa/eslint-config": "workspace:*",
    "@mfa/remote-config": "workspace:*",
    "@mfa/typescript-config": "workspace:*",
    "@module-federation/rsbuild-plugin": "catalog:",
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-react": "^2.1.0",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "postcss": "^8.5.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
