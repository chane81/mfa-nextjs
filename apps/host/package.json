{
  "name": "@mfa/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "concurrently --kill-others --success first -n catalog,cart,next -c magenta,green,gray \"node ../../scripts/serve-remote-dist.mjs 3001 ../remote-catalog/dist\" \"node ../../scripts/serve-remote-dist.mjs 3002 ../remote-cart/dist\" \"next build\"",
    "docker:build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@mfa/contracts": "workspace:*",
    "@mfa/ui": "workspace:*",
    "@module-federation/runtime": "^2.8.2",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@mfa/eslint-config": "workspace:*",
    "@mfa/typescript-config": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.1",
    "typescript": "6.0.3"
  }
}
