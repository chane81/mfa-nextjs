{
  "name": "@mfa/remote-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,ssr -c magenta,gray --kill-others-on-fail \"vite\" \"vite build --config vite.config.server.ts --watch\"",
    "build": "node ../../scripts/mf-build-version.ts && vite build && pnpm build:ssr && pnpm stamp",
    "build:ssr": "vite build --config vite.config.server.ts",
    "stamp": "node ../../scripts/stamp-remote-version.ts catalog",
    "start": "node ../../scripts/serve-remote-dist.ts catalog",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .mf-version .turbo node_modules/.vite"
  },
  "dependencies": {
    "@mfa/contracts": "workspace:*",
    "@mfa/tailwind-config": "workspace:*",
    "@mfa/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@mfa/eslint-config": "workspace:*",
    "@mfa/remote-config": "workspace:*",
    "@mfa/typescript-config": "workspace:*",
    "@module-federation/vite": "^1.20.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.1"
  }
}
