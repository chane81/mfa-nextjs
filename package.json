{
  "name": "mfa-nextjs",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:wait-remotes": "node scripts/wait-for-remotes.mjs",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@mfa/eslint-config": "workspace:*",
    "@mfa/typescript-config": "workspace:*",
    "prettier": "3.6.2",
    "turbo": "2.10.9",
    "typescript": "6.0.3"
  }
}
