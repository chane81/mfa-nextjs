{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "pnpm-lock.yaml"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_REMOTE_CATALOG_ENTRY",
    "NEXT_PUBLIC_REMOTE_CART_ENTRY",
    "REMOTE_CATALOG_SSR_ENTRY",
    "REMOTE_CART_SSR_ENTRY",
    "ZONE_CHECKOUT_URL",
    // remote 재배포 → host 캐시 무효화 웹훅 시크릿.
    // 여기 등록하지 않으면 turbo 가 태스크 환경에서 걸러낸다(strict env).
    "MF_REVALIDATE_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
