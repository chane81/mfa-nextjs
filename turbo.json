{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "pnpm-lock.yaml"],
  "globalEnv": [
    "NODE_ENV",
    "REMOTE_*",
    "MFA_REMOTE_WEB_ENTRIES",
    "MF_*",
    "PORT",
    "WAIT_FOR_REMOTES_TIMEOUT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@mfa/host#build": {
      "dependsOn": [
        "^build",
        "@mfa/remote-catalog#build",
        "@mfa/remote-cart#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@mfa/host#docker:build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@mfa/host#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:wait-remotes"]
    },
    "//#dev:wait-remotes": {
      "cache": false
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "//#typecheck:scripts": {
      "dependsOn": ["^build"],
      "inputs": ["scripts/**/*.ts", "packages/utils/src/**", "tsconfig.json"]
    },
    "//#typecheck:tests": {
      "inputs": ["tests/**", "vitest.config.ts", "tsconfig.test.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
