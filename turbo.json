{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "pnpm-lock.yaml"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_REMOTE_CATALOG_ENTRY",
    "NEXT_PUBLIC_REMOTE_CART_ENTRY",
    "REMOTE_CATALOG_SSR_ENTRY",
    "REMOTE_CART_SSR_ENTRY",
    // remote 재배포 → host 캐시 무효화 웹훅 시크릿.
    // 여기 등록하지 않으면 turbo 가 태스크 환경에서 걸러낸다(strict env).
    "MF_REVALIDATE_SECRET",
    // remote 신뢰 경계 (docs/04-experiments/03-cache-modes.md 발견 9)
    "REMOTE_ALLOWED_ORIGINS",
    "MF_REMOTE_PUBLIC_KEY",
    "MF_REQUIRE_SIGNATURE",
    "MF_REQUIRE_INTEGRITY",
    // remote 빌드가 매니페스트에 서명할 때 쓰는 개인키 (remote 파이프라인 전용)
    "MF_SIGNING_KEY",
    "MF_BUILD_VERSION",
    // remote 자산 URL 접두사. 빌드 시점에 산출물에 굳는다 (docs/03-setup/04-dokploy.md)
    "REMOTE_CATALOG_PUBLIC_URL",
    "REMOTE_CART_PUBLIC_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    /**
     * host 빌드는 순수한 컴파일이 아니다. 프리렌더 중에 remote 의 SSR 번들을 HTTP 로 받아
     * 실행하므로(`apps/host/src/mf/server-loader.ts`) 빌드 시점에 remote 오리진이 살아 있어야 한다.
     * 배포에서는 remote 가 이미 떠 있어서 안 보이던 요구사항이다.
     *
     * 그래서 두 가지가 필요하다.
     *   ① remote 를 먼저 빌드한다        → 여기서 선언한다
     *   ② 빌드된 dist 를 띄운 채로 둔다   → turbo 가 못 한다
     *
     * ②를 turbo 로 쓰면 `with`(사이드카) + 유한 readiness 프로브 조합인데, 사이드카가
     * `persistent: true` 라 host 빌드가 끝나도 죽지 않아 **`turbo run build` 가 종료하지 않는다**
     * (실측). 그 패턴은 Ctrl-C 로 끝내는 `dev` 용이지 반드시 exit 해야 하는 `build` 용이 아니다.
     * 그 한 걸음만 host 의 build 스크립트가 감싼다(scripts/with-remote-dist.mjs).
     *
     * ⚠️ 패키지 스코프 설정은 기본 `build` 를 **상속하지 않고 대체**한다. outputs 를 다시 적는 이유다.
     */
    "@mfa/host#build": {
      "dependsOn": ["^build", "@mfa/remote-catalog#build", "@mfa/remote-cart#build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },

    /**
     * 이미지용 host 빌드. `build` 와 산출물은 같고 **remote 게이트만 없다.**
     *
     * 이미지 안에서 remote 는 이미 배포된 공개 도메인이다. 워크스페이스 remote 를 빌드할
     * 이유가 없을 뿐 아니라, 빌드해버리면 catalog 빌드가 깨질 때 host 배포까지 같이 깨진다 —
     * 이 저장소가 증명하려는 독립 배포가 빌드 그래프에서 다시 묶인다.
     *
     * 이름을 나눠 끊는다. `--filter` 는 `pkg#task` 의존을 필터와 무관하게 끌고 오므로
     * 같은 `build` 이름으로는 못 끊는다(끊으려면 Dockerfile 이 `--only` 같은 플래그로
     * turbo.json 을 되돌려야 하고, 그러면 의도가 두 파일에 흩어진다).
     *
     * 로컬에서 이걸 직접 부를 일은 없다. remote 가 안 떠 있으면 프리렌더가 ECONNREFUSED 로
     * 죽는다 — 그게 `build` 가 감싸주는 부분이다.
     */
    "@mfa/host#docker:build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },

    /**
     * host 는 remote 가 준비된 뒤에 뜬다.
     *
     * turbo 로는 "remote dev 가 먼저" 를 직접 못 쓴다 — persistent 태스크에는 의존할 수
     * 없기 때문이다(끝나지 않는 태스크에 의존하면 의존하는 쪽이 영영 안 돈다. turbo 가
     * `persistent: true` 로 그 상황을 막는다). `with` 는 동시 실행이지 순서가 아니다.
     *
     * 그래서 **끝나는** 태스크로 준비를 기다리게 하고 host 만 거기에 의존시킨다.
     * `dev` 전체에 걸면 remote 도 이 태스크를 기다리게 되어 교착한다 — 대기 태스크는
     * remote 가 뜨기를 기다리는데 remote 는 대기 태스크가 끝나기를 기다린다.
     *
     * 근거: scripts/wait-for-remotes.mjs
     */
    "@mfa/host#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:wait-remotes"]
    },

    // 캐시하면 두 번째 실행부터 대기를 건너뛰어 존재 이유가 사라진다
    "//#dev:wait-remotes": {
      "cache": false
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
