{
  "extends": "@mfa/typescript-config/react-library.json",
  "compilerOptions": {
    /**
     * 테스트 코드 전용 프로그램.
     *
     * 소스 옆의 테스트는 **각 패키지 tsconfig 가** 검사한다(편집기의 TS 서버가 그 파일을
     * 프로젝트에 넣을 수 있어야 하기 때문 — 빼두면 `ts(2307)` 로 alias 를 못 찾는다).
     * emit 하는 패키지만 `tsconfig.build.json` 을 따로 두어 거기서 테스트를 뺀다.
     *
     * 그래서 이 프로그램이 맡는 건 **루트 `tests/` 의 공유 셋업·헬퍼와 `vitest.config.ts`**
     * 뿐이다. 그쪽은 어느 패키지에도 속하지 않아 따로 검사할 자리가 없다.
     */
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "tsBuildInfoFile": "./.turbo/tsconfig.test.tsbuildinfo",
    /**
     * `vitest.config.ts` 의 alias 와 **같은 대상을 가리켜야 한다.** 갈라지면 타입은
     * 통과하는데 런타임에서 다른 파일이 로드되거나 그 반대가 된다.
     */
    "paths": {
      "@tests/*": ["./tests/*"],
      "@mfa/store/server": ["./packages/store/src/server.ts"],
      "@mfa/store": ["./packages/store/src/index.ts"],
      "@mfa/contracts": ["./packages/contracts/src/index.ts"],
      "@mfa/ui": ["./packages/ui/src/index.ts"],
      "@mfa/remote-config/node": ["./packages/remote-config/src/node.ts"],
      "@mfa/remote-config": ["./packages/remote-config/src/index.ts"],
      "@/*": ["./apps/host/src/*"]
    }
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
